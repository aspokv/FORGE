# =============================================================================
# FORGE BACKEND — environment variables for production
# Copy this to .env and fill in real values. Never commit .env to version control.
# =============================================================================

# --- MongoDB (REQUIRED) ---
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="forge_production"

# --- JWT Secret (REQUIRED) — generate with: python -c "import secrets; print(secrets.token_hex(32))" ---
FORGE_JWT_SECRET=

# --- API keys for AI features (optional — Coach and Vision will be disabled if absent) ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- CORS (REQUIRED for production) — comma-separated origins, NO trailing slash ---
CORS_ORIGINS="https://your-frontend-domain.com"

# --- Super admin seed (REQUIRED for first deploy) ---
FORGE_SUPER_ADMIN_EMAIL="admin@yourdomain.com"

# --- Cobrança / Mercado Pago (assinaturas recorrentes) ---
# Token da conta do FORGE. "TEST-..." usa o checkout sandbox; "APP_USR-..." usa produção.
# A escolha da URL é automática a partir do prefixo — não existe flag separada.
MP_ACCESS_TOKEN=
# Segredo da assinatura do webhook (Mercado Pago > Suas integrações > Webhooks).
# Sem ele o webhook recusa TUDO — é o que impede alguém liberar assinatura de graça.
MP_WEBHOOK_SECRET=
# IDs dos três preapproval_plan criados na conta. Sem eles o checkout responde 503.
MP_ESSENTIAL_PLAN_ID=
MP_PRO_PLAN_ID=
MP_ELITE_PLAN_ID=
# Base usada nas back_url do checkout.
FORGE_SITE_URL="https://forge.aiexec.com.br"
# Feature flag da cobrança. Desligada (padrão), ninguém é bloqueado por falta de
# assinatura: a página de planos e o checkout funcionam, mas o acesso segue liberado.
BILLING_ENFORCED=false
# Data de corte do grandfathering (ISO). Contas criadas ANTES disso mantêm acesso de
# cortesia para sempre. Sem definir, todo usuário conta como anterior à cobrança.
BILLING_GRANDFATHER_BEFORE=
# Cadastro público (funil de aquisição). Depende de provedor de e-mail real: o provedor
# padrão apenas registra o código no log do servidor.
PUBLIC_SIGNUP_ENABLED=false

# --- E-mail (Resend) ---
# Sem RESEND_API_KEY o provedor cai no "console", que apenas registra o código no log do
# servidor — util em sandbox, inutil em produção. A seleção é pela presença da chave.
RESEND_API_KEY=
FORGE_EMAIL_FROM="FORGE <acesso@mail.aiexec.com.br>"

# Ambiente do Mercado Pago: "sandbox" ou "production". EXPLÍCITO de propósito —
# credenciais de teste de aplicações atuais também começam com APP_USR-, então deduzir
# pelo prefixo do token escolheria a URL errada em silêncio. Ausente ou inválido cai em
# sandbox (o lado que não cobra ninguém) e registra o erro no log.
MP_ENVIRONMENT=sandbox
