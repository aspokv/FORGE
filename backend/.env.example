# =============================================================================
# FORGE BACKEND — environment variables for production
# Copy this to .env and fill in real values. Never commit .env to version control.
# =============================================================================

# --- MongoDB (REQUIRED) ---
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="forge_production"

# --- JWT Secret (REQUIRED) — generate with: python -c "import secrets; print(secrets.token_hex(32))" ---
FORGE_JWT_SECRET=

# --- API keys for AI features (optional — Coach and Vision will be disabled if absent) ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- CORS (REQUIRED for production) — comma-separated origins, NO trailing slash ---
CORS_ORIGINS="https://your-frontend-domain.com"

# --- Super admin seed (REQUIRED for first deploy) ---
FORGE_SUPER_ADMIN_EMAIL="admin@yourdomain.com"
